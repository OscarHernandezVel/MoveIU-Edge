# Configuración del agente a bordo. Copie este archivo como edge/edge.env y ajústelo.
# Bus que representa la maqueta (debe existir en el servidor: backend/demo_data/pasto_c1_c4.json).
EDGE_BUS_ID=2101
EDGE_ROUTE_ID=C1
# Servidor central. http:// solo se acepta en la red local (IP privada, localhost o *.local); si no, https://.
EDGE_SERVER_URL=http://192.168.1.50:8080
# Igual a CORE_INGEST_KEY del servidor. Mejor en un archivo aparte (chmod 600):
EDGE_INGEST_KEY=
# EDGE_INGEST_KEY_FILE=/etc/bus-edge/ingest_key
# Arduino: auto (lo busca por USB), /dev/arduino (regla udev), COM3 (Windows) o sim (simulado).
EDGE_SERIAL_PORT=auto
# Cámaras: front=0,rear=1 | rutas estables /dev/v4l/by-path/... | off
EDGE_CAMERAS=front=0,rear=1
EDGE_MODEL_PATH=models/yolov8n.onnx
# Resolución del modelo (320 por defecto; con minifiguras de Lego pruebe 640) y clases que cuentan como pasajero:
# 0 = persona (COCO) o el id de su clase lego_minifigure si entrenó un modelo propio (docs/lego.md).
# EDGE_MODEL_INPUT=640
# EDGE_DETECTOR_CLASSES=0
EDGE_VISION_FPS=5
EDGE_LAYOUT=maqueta/bus_2101_layout.json
# GPS: replay (recorre la ruta real, recomendado en interiores), /dev/serial0 (NEO-6M) o fixed:1.2136,-77.2811
EDGE_GPS=replay
EDGE_ROUTE_PACKAGE=../backend/demo_data/pasto_c1_c4.json
EDGE_REPLAY_SPEED_KMH=25
# Cada cuántos segundos se envía una lectura (v7: 3 s).
EDGE_SEND_INTERVAL=3
EDGE_OUTBOX=data/outbox.sqlite3
