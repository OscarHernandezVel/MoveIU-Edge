# Configuración del agente a bordo. Copie este archivo como edge/edge.env y ajústelo
# (deploy/setup_windows.ps1 lo copia por usted). Valores pensados para el portátil con Windows de la maqueta.
# Bus que representa la maqueta (debe existir en el servidor: backend/demo_data/pasto_c1_c4.json).
EDGE_BUS_ID=2101
EDGE_ROUTE_ID=C1
# Servidor central. http:// solo se acepta en la red local (IP privada, localhost o *.local); si no, https://.
# Si el servidor corre en el mismo portátil: http://127.0.0.1:8080
EDGE_SERVER_URL=http://192.168.1.50:8080
# Igual a CORE_INGEST_KEY del servidor. Mejor en un archivo aparte, fuera de la carpeta del proyecto:
EDGE_INGEST_KEY=
# EDGE_INGEST_KEY_FILE=C:\Users\<usuario>\bus-edge\ingest_key.txt
# Arduino: auto (lo busca por USB), COM3 (Windows; vea el puerto en el Arduino IDE) o sim (simulado).
# En Linux o Raspberry: auto, /dev/ttyACM0 o /dev/arduino (regla udev de deploy/).
EDGE_SERIAL_PORT=auto
# Cámaras: en el portátil la integrada suele ser 0 y las webcams USB 1 y 2 (confírmelo con: python -m bus_edge check).
# Sin cámaras todavía: front=sim,rear=sim (la maqueta en 3D vista desde cada cámara, con tantas figuras como diga el
# contador de puertas), videos grabados que se repiten en bucle (front=videos\frente.mp4,rear=videos\atras.mp4), u off.
EDGE_CAMERAS=front=1,rear=2
# Detector: lego (cabezas amarillas de las minifiguras, por color; no necesita modelo), yolo (models/yolov8n.onnx) o none.
EDGE_DETECTOR=lego
# Umbrales del amarillo (matiz mín., matiz máx., saturación mín., brillo mín.): ajústelos con la luz de la maqueta.
# EDGE_LEGO_HSV=20,35,150,90
EDGE_MODEL_PATH=models/yolov8n.onnx
# Resolución del modelo: 640 en el portátil (las minifiguras del fondo miden ~30 píxeles); 320 en una Raspberry.
# Clases que cuentan como pasajero: 0 = persona (COCO) o el id de su clase lego_minifigure (docs/lego.md).
EDGE_MODEL_INPUT=640
# EDGE_DETECTOR_CLASSES=0
EDGE_VISION_FPS=5
EDGE_LAYOUT=maqueta/bus_2101_layout.json
# GPS: replay (recorre la ruta real; el portátil no tiene GPS), fixed:1.2136,-77.2811
# o el puerto de un NEO-6M con adaptador USB-TTL (COM5 en Windows, /dev/serial0 en una Raspberry).
EDGE_GPS=replay
EDGE_ROUTE_PACKAGE=../backend/demo_data/pasto_c1_c4.json
EDGE_REPLAY_SPEED_KMH=25
# Cada cuántos segundos se envía una lectura (v7: 3 s).
EDGE_SEND_INTERVAL=3
EDGE_OUTBOX=data/outbox.sqlite3
